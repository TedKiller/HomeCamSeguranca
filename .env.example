# Copie este arquivo para `.env` e preencha ao implantar via Docker, VPS Linux ou systemd.

# Senha da camera (necessaria fora do PC Windows original, pois o DPAPI do config.json e vinculado ao Windows)
HOMECAM_CAM_PASSWORD=

# Opcional: URL RTSP/DVRIP completa sobrescrevendo o IP local (ex.: usando Tailscale Subnet Router 100.x ou IP da LAN)
# HOMECAM_RTSP_URL=rtsp://admin:SENHA@192.168.1.2:554/stream1

# Token obrigatorio para proteger a API REST e o Portal Web quando exposto remotamente
HOMECAM_WEB_TOKEN=troque-por-um-token-forte
HOMECAM_WEB_PORT=8765

# Em VPS Cloud com GPU NVIDIA + CUDA use onnxruntime-gpu; em CPU/MiniPC/RPi use onnxruntime
ORT_PACKAGE=onnxruntime

